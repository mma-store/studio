
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function getProfile() {
      // Direct access with Auth UID should be safe within limits
      return get(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        getProfile().accountType == 'super_admin'
      );
    }

    function isTenantMember(tenantId) {
      return isAuthenticated() && (getProfile().tenantId == tenantId || isSuperAdmin());
    }

    function isTenantAdmin(tenantId) {
      return isAuthenticated() && (
        (getProfile().tenantId == tenantId && getProfile().role in ['owner', 'admin']) || 
        isSuperAdmin()
      );
    }

    // --- Identity Rules ---
    match /accountProfiles/{uid} {
      allow read, write: if isAuthenticated() && (request.auth.uid == uid || isSuperAdmin());
    }

    match /users/{uid} {
      allow read, write: if isAuthenticated() && (request.auth.uid == uid || isSuperAdmin());
    }

    match /tenants/{tenantId} {
      allow read: if isAuthenticated(); // Allow reading metadata for any store
      allow create: if isAuthenticated();
      allow update: if isTenantAdmin(tenantId);
    }

    match /slugs/{slug} {
      allow read: if true;
      allow create, update: if isAuthenticated();
    }

    match /plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // --- Global Read Access for Storefront Discovery ---
    match /products/{id} {
      allow read: if isAuthenticated();
      allow write: if isTenantAdmin(request.resource.data.tenantId || resource.data.tenantId);
    }
    match /categories/{id} {
      allow read: if isAuthenticated();
      allow write: if isTenantAdmin(request.resource.data.tenantId || resource.data.tenantId);
    }
    match /banners/{id} {
      allow read: if isAuthenticated();
      allow write: if isTenantAdmin(request.resource.data.tenantId || resource.data.tenantId);
    }
    match /offers/{id} {
      allow read: if isAuthenticated();
      allow write: if isTenantAdmin(request.resource.data.tenantId || resource.data.tenantId);
    }
    match /motorcycleTypes/{id} {
      allow read: if isAuthenticated();
      allow write: if isTenantAdmin(request.resource.data.tenantId || resource.data.tenantId);
    }

    // --- Private Operational Data Rules ---
    match /{path=**} {
      // Force tenant matching for all other operational data (orders, etc)
      allow read: if isAuthenticated() && (
        (resource.data.tenantId != null && resource.data.tenantId == getProfile().tenantId) || 
        isSuperAdmin()
      );
      allow write: if isAuthenticated() && (
        (request.resource.data.tenantId != null && request.resource.data.tenantId == getProfile().tenantId && getProfile().role in ['owner', 'admin']) ||
        isSuperAdmin()
      );
    }
  }
}
