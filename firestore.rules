
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- وظائف مساعدة (Helper Functions) ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function getProfile() {
      // الوصول المباشر لملف الهوية الموحد بالـ UID
      return get(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        getProfile().accountType == 'super_admin' || getProfile().role == 'super_admin'
      );
    }

    function isTenantMember(tenantId) {
      return isAuthenticated() && (getProfile().tenantId == tenantId || isSuperAdmin());
    }

    function isTenantAdmin(tenantId) {
      return isAuthenticated() && (
        (getProfile().tenantId == tenantId && getProfile().role in ['owner', 'admin']) || 
        isSuperAdmin()
      );
    }

    // --- قواعد الهوية (Identity Rules) ---
    match /accountProfiles/{uid} {
      allow read, write: if isAuthenticated() && (request.auth.uid == uid || isSuperAdmin());
    }

    match /users/{uid} {
      allow read, write: if isAuthenticated() && (request.auth.uid == uid || isSuperAdmin());
    }

    match /tenants/{tenantId} {
      allow read: if isAuthenticated(); // السماح بقراءة بيانات المتجر الأساسية لأي مستخدم مسجل
      allow create: if isAuthenticated(); // السماح للمستخدمين الجدد بإنشاء متجر
      allow update: if isTenantAdmin(tenantId);
    }

    match /slugs/{slug} {
      allow read: if true;
      allow create, update: if isAuthenticated();
    }

    match /plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // --- قواعد البيانات العامة للمتجر (Discovery) ---
    // يمكن للزبائن المسجلين القراءة، والمديرين فقط الكتابة
    match /products/{id} {
      allow read: if isAuthenticated();
      allow write: if isTenantAdmin(request.resource.data.tenantId || resource.data.tenantId);
    }
    match /categories/{id} {
      allow read: if isAuthenticated();
      allow write: if isTenantAdmin(request.resource.data.tenantId || resource.data.tenantId);
    }
    match /banners/{id} {
      allow read: if isAuthenticated();
      allow write: if isTenantAdmin(request.resource.data.tenantId || resource.data.tenantId);
    }
    match /offers/{id} {
      allow read: if isAuthenticated();
      allow write: if isTenantAdmin(request.resource.data.tenantId || resource.data.tenantId);
    }

    // --- قواعد البيانات التشغيلية والخاصة (Private/Operational) ---
    // تفرض عزلاً تاماً بناءً على الـ tenantId
    match /{path=**} {
      allow read: if isAuthenticated() && (
        (resource.data.tenantId != null && resource.data.tenantId == getProfile().tenantId) || 
        isSuperAdmin()
      );
      allow write: if isAuthenticated() && (
        (request.resource.data.tenantId != null && request.resource.data.tenantId == getProfile().tenantId && getProfile().role in ['owner', 'admin']) ||
        isSuperAdmin()
      );
    }
  }
}
