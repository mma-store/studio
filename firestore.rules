rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // وظائف مساعدة
    function isAuthenticated() {
      return request.auth != null;
    }

    // جلب بيانات البروفايل بأمان وبدون استدعاء تداخلي
    function getProfile() {
      return get(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data;
    }

    function getUserTenantId() {
      return getProfile().tenantId;
    }

    function isTenantMember(tid) {
      return isAuthenticated() && getUserTenantId() == tid;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'rQR8k4ZzIZVtvkQ2pUHNlvIDSI13' || 
        getProfile().role == 'super_admin'
      );
    }

    // 1. الهوية الرقمية (UID-Keyed) - الوصول مباشر وسريع
    match /accountProfiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isSuperAdmin();
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow read, write: if isSuperAdmin();
    }

    // 2. سجل الروابط (Slug Registry) - قراءة عامة للجميع
    match /slugs/{slug} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // 3. المجموعات التسويقية (Public Access لمتجر العميل)
    match /{collectionName}/{docId} {
      allow read: if collectionName in ['products', 'categories', 'banners', 'offers', 'motorcycleTypes'] 
                  && (resource == null || resource.data.tenantId != null);
      
      // الكتابة محصورة فقط لأعضاء الـ Tenant
      allow write: if isAuthenticated() && (
        isTenantMember(resource.data.tenantId) || 
        isTenantMember(request.resource.data.tenantId) || 
        isSuperAdmin()
      );
    }

    // 4. البيانات الحساسة (عزل تام حسب الـ Tenant)
    match /{collectionName}/{docId} {
      allow read, write: if collectionName in [
        'orders', 'suppliers', 'purchases', 'expenses', 
        'repairOrders', 'financialTransactions', 'receiptVouchers', 
        'paymentVouchers', 'cashShifts', 'auditLogs', 'apiKeys', 
        'webhooks', 'tenantIntegrations', 'returns', 'subscriptionInvoices'
      ] && isAuthenticated() && (
        (resource != null && isTenantMember(resource.data.tenantId)) || 
        (request.resource != null && isTenantMember(request.resource.data.tenantId)) ||
        isSuperAdmin()
      );
    }

    // 5. البنية التحتية العالمية
    match /tenants/{tenantId} {
      allow read: if true; // القراءة العامة مسموحة لجلب بيانات Branding المتجر
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (getUserTenantId() == tenantId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /integrations/{id} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /systemLogs/{id} {
      allow create: if true;
      allow read: if isSuperAdmin();
    }
  }
}
