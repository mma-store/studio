rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Basic Auth Helpers ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // --- Identity Resolution (Safe & Non-Recursive) ---
    // Reads profile without using helper functions that might recurse
    function getRawProfile() {
      return get(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)) && 
        (getRawProfile().accountType == 'super_admin' || getRawProfile().role == 'super_admin');
    }

    function getUserTenantId() {
      return getRawProfile().tenantId;
    }

    // --- Domain Helpers ---
    function isTenantMember(tenantId) {
      return isAuthenticated() && (
        isSuperAdmin() || 
        (exists(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)) && getRawProfile().tenantId == tenantId)
      );
    }

    function isTenantAdmin(tenantId) {
      return isAuthenticated() && (
        isSuperAdmin() || 
        (exists(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)) && 
         getRawProfile().tenantId == tenantId && 
         getRawProfile().role in ['owner', 'admin'])
      );
    }

    // --- Identity Rules ---
    match /accountProfiles/{uid} {
      allow read: if isOwner(uid) || isSuperAdmin();
      allow write: if isOwner(uid) || isSuperAdmin();
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid) || isSuperAdmin();
    }

    // --- Tenant Rules ---
    match /tenants/{tenantId} {
      allow read: if isAuthenticated() && isTenantMember(tenantId);
      allow create: if isAuthenticated(); // New merchants can create their first tenant
      allow update: if isTenantAdmin(tenantId);
    }

    match /slugs/{slug} {
      allow read: if true;
      allow create, update: if isAuthenticated();
    }

    // --- Global Data ---
    match /plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // --- Business Data (Tenant Isolated) ---
    // Any scoped data must match the user's tenantId
    match /{path=**} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        (resource.data.tenantId != null && exists(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)) && resource.data.tenantId == getUserTenantId())
      );
      allow write: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.resource.data.tenantId != null && exists(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)) && request.resource.data.tenantId == getUserTenantId() && getRawProfile().role in ['owner', 'admin'])
      );
    }
  }
}