rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    // Safe profile data access
    function getProfileData() {
      return get(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data;
    }
    
    function profileExists() {
      return exists(/databases/$(database)/documents/accountProfiles/$(request.auth.uid));
    }

    // Internal check for roles - ONLY used where tenantId is present
    function isSuperAdmin() {
      return isAuthenticated() && profileExists() && 
        (getProfileData().accountType == 'super_admin' || getProfileData().role == 'super_admin');
    }

    function isTenantMember(tenantId) {
      return isAuthenticated() && (
        isSuperAdmin() || (profileExists() && getProfileData().tenantId == tenantId)
      );
    }

    function isTenantAdmin(tenantId) {
      return isAuthenticated() && (
        isSuperAdmin() || (profileExists() && getProfileData().tenantId == tenantId && getProfileData().role in ['owner', 'admin'])
      );
    }

    // --- Identity Rules (REFACTORED: No circular helpers) ---
    // Users can ALWAYS read/write their own records using direct UID matching
    match /accountProfiles/{uid} {
      allow read, write: if isAuthenticated() && (request.auth.uid == uid);
      // Super admin can manage other profiles
      allow read, write: if isAuthenticated() && request.auth.uid != uid && isSuperAdmin();
    }

    match /users/{uid} {
      allow read, write: if isAuthenticated() && (request.auth.uid == uid);
      allow read, write: if isAuthenticated() && request.auth.uid != uid && isSuperAdmin();
    }

    // --- Tenant Rules ---
    match /tenants/{tenantId} {
      allow read: if isAuthenticated() && isTenantMember(tenantId);
      allow create: if isAuthenticated();
      allow update: if isTenantAdmin(tenantId);
    }

    match /slugs/{slug} {
      allow read: if true;
      allow create, update: if isAuthenticated();
    }

    // --- Global Platform Data ---
    match /plans/{planId} {
      allow read: if true; 
      allow write: if isSuperAdmin();
    }

    // --- Operational Data (Tenant Isolated) ---
    // Products and Categories are public to read for logged-in users, but protected for write
    match /products/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isTenantAdmin(request.resource.data.tenantId || resource.data.tenantId);
    }
    match /categories/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isTenantAdmin(request.resource.data.tenantId || resource.data.tenantId);
    }
    match /banners/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isTenantAdmin(request.resource.data.tenantId || resource.data.tenantId);
    }
    match /offers/{id} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isTenantAdmin(request.resource.data.tenantId || resource.data.tenantId);
    }

    // --- Catch-all Private Tenant Data ---
    match /{path=**} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() || 
        (resource.data.tenantId != null && profileExists() && resource.data.tenantId == getProfileData().tenantId)
      );
      allow write: if isAuthenticated() && (
        isSuperAdmin() ||
        (request.resource.data.tenantId != null && profileExists() && request.resource.data.tenantId == getProfileData().tenantId && getProfileData().role in ['owner', 'admin'])
      );
    }
  }
}