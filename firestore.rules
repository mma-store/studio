rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // وظائف مساعدة
    function isAuthenticated() {
      return request.auth != null;
    }

    // القواعد الأساسية للهوية الرقمية
    match /accountProfiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // سجل الروابط (Slug Registry) - قراءة عامة للجميع
    match /slugs/{slug} {
      allow read: if true;
      allow create: if isAuthenticated();
    }

    // بيانات المتجر الأساسية (Branding) - قراءة عامة
    match /tenants/{tenantId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        get(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data.tenantId == tenantId
      );
    }

    // المجموعات التسويقية العامة للمتجر (Public Storefront)
    match /{collectionName}/{docId} {
      allow read: if collectionName in ['products', 'categories', 'banners', 'offers', 'motorcycleTypes'] 
                  && (resource == null || resource.data.tenantId != null);
      
      // الكتابة محصورة فقط لأعضاء الـ Tenant بناءً على الهوية الموثقة
      allow write: if isAuthenticated() && (
        request.resource.data.tenantId == get(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data.tenantId ||
        resource.data.tenantId == get(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data.tenantId
      );
    }

    // البيانات التشغيلية الحساسة (عزل تام حسب الـ Tenant)
    match /{collectionName}/{docId} {
      allow read, write: if collectionName in [
        'orders', 'suppliers', 'purchases', 'expenses', 
        'repairOrders', 'financialTransactions', 'receiptVouchers', 
        'paymentVouchers', 'cashShifts', 'auditLogs', 'apiKeys', 
        'webhooks', 'tenantIntegrations', 'returns', 'subscriptionInvoices'
      ] && isAuthenticated() && (
        (resource != null && resource.data.tenantId == get(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data.tenantId) || 
        (request.resource != null && request.resource.data.tenantId == get(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data.tenantId)
      );
    }

    // المجموعات العالمية للمنصة
    match /plans/{planId} {
      allow read: if true;
    }

    match /integrations/{id} {
      allow read: if true;
    }

    match /settings/{id} {
      allow read: if true;
    }
  }
}