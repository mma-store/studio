
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function getProfile() {
      // Use UID-keyed lookup for performance and security
      return get(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        get(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data.accountType == 'super_admin'
      );
    }

    function isTenantMember(tenantId) {
      return isAuthenticated() && (getProfile().tenantId == tenantId || isSuperAdmin());
    }

    function isTenantAdmin(tenantId) {
      return isAuthenticated() && (
        (getProfile().tenantId == tenantId && getProfile().role in ['owner', 'admin']) || 
        isSuperAdmin()
      );
    }

    // --- Identity Rules ---
    match /accountProfiles/{uid} {
      allow read, write: if isAuthenticated() && (request.auth.uid == uid || isSuperAdmin());
    }

    match /users/{uid} {
      allow read, write: if isAuthenticated() && (request.auth.uid == uid || isSuperAdmin());
    }

    match /tenants/{tenantId} {
      allow read: if isTenantMember(tenantId);
      allow create: if isAuthenticated();
      allow update: if isTenantAdmin(tenantId);
    }

    match /slugs/{slug} {
      allow read: if true;
      allow create, update: if isAuthenticated();
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // --- Operational Data Rules ---
    match /{path=**} {
      // General rule for all documents: check tenantId field
      allow read: if isAuthenticated() && (
        resource.data.tenantId == getProfile().tenantId || isSuperAdmin()
      );
      allow write: if isAuthenticated() && (
        (request.resource.data.tenantId == getProfile().tenantId && getProfile().role in ['owner', 'admin']) ||
        isSuperAdmin()
      );
    }
  }
}
