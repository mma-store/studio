rules_version = '2';
service cloud.firestore {
  match /databases/saas-prod/documents {
    
    // ==========================================
    // 1. الوظائف المساعدة الأساسية
    // ==========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'rQR8k4ZzIZVtvkQ2pUHNlvIDSI13' || 
        get(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    // جلب الـ tenantId للمستخدم الحالي
    function getUserTenantId() {
      return get(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data.tenantId;
    }

    function isTenantMember(tid) {
      return isAuthenticated() && getUserTenantId() == tid;
    }

    // ==========================================
    // 2. الهوية الرقمية (Identity Layer)
    // ==========================================
    
    match /accountProfiles/{uid} {
      // يسمح للمستخدم بقراءة وإنشاء ملفه الخاص
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
      allow read: if isSuperAdmin();
    }

    match /users/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow write: if isAuthenticated() && isTenantMember(request.resource.data.tenantId);
      allow read, write: if isSuperAdmin();
    }

    // ==========================================
    // 3. البيانات التشغيلية (Tenant Isolation)
    // ==========================================
    
    match /{collectionName}/{id} {
      // مجموعات بيانات المتجر القابلة للقراءة العامة للزبائن
      allow read: if collectionName in ['products', 'categories', 'banners', 'offers', 'motorcycleTypes'];
      
      // العزل التام للمستأجرين في المجموعات التشغيلية
      allow read: if isAuthenticated() && (isTenantMember(resource.data.tenantId) || isSuperAdmin());
      allow create: if isAuthenticated() && (isTenantMember(request.resource.data.tenantId) || isSuperAdmin());
      allow update: if isAuthenticated() && (isTenantMember(request.resource.data.tenantId) || isSuperAdmin());
      allow delete: if isAuthenticated() && (isTenantMember(resource.data.tenantId) || isSuperAdmin());
    }

    // ==========================================
    // 4. البنية التحتية للمنصة (Global)
    // ==========================================
    
    match /tenants/{tenantId} {
      allow create: if isAuthenticated(); 
      allow read: if isAuthenticated() && (getUserTenantId() == tenantId || isSuperAdmin());
      allow update: if isAuthenticated() && (getUserTenantId() == tenantId || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    match /slugs/{slug} {
      allow read: if true; 
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    
    match /systemLogs/{id} {
      allow create: if true; 
      allow read: if isSuperAdmin();
    }
  }
}
