
rules_version = '2';
service cloud.firestore {
  match /databases/saas-prod/documents {
    
    // ==========================================
    // 1. الوظائف المساعدة الأساسية
    // ==========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // جلب بيانات البروفايل للتحقق من الصلاحيات والـ Tenant
    function getProfileData() {
      return get(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data;
    }

    function isTenantMember(tid) {
      return isAuthenticated() && getProfileData().tenantId == tid;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (getProfileData().accountType == 'super_admin' || getProfileData().role == 'super_admin');
    }

    // ==========================================
    // 2. إدارة الهوية (Identity Layer)
    // ==========================================
    
    // فك الارتباط: لا نستدعي getProfileData داخل هذه القاعدة لمنع الحلقة المفرغة
    match /accountProfiles/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
      allow read: if isSuperAdmin();
    }

    match /users/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow write: if isAuthenticated() && isTenantMember(request.resource.data.tenantId);
      allow read, write: if isSuperAdmin();
    }

    // ==========================================
    // 3. البيانات التشغيلية (Tenant-Scoped Data)
    // ==========================================
    
    match /{collectionName}/{id} {
      // السماح بالقراءة العامة لبيانات واجهة المتجر لغير المسجلين
      allow read: if collectionName in ['products', 'categories', 'banners', 'offers', 'motorcycleTypes'];
      
      // قواعد القراءة والكتابة للأعضاء (معزولة بالـ Tenant)
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow write: if isAuthenticated() && isTenantMember(request.resource.data.tenantId);
      
      // صلاحيات الـ Super Admin
      allow read, write: if isSuperAdmin();
    }

    // استثناء للسجلات الحساسة (لا قراءة عامة)
    match /subscriptionInvoices/{id} {
      allow read, write: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow read, write: if isSuperAdmin();
    }

    match /auditLogs/{id} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow create: if isAuthenticated();
      allow read, write: if isSuperAdmin();
    }

    // ==========================================
    // 4. البنية التحتية العالمية (Global Registry)
    // ==========================================
    
    match /tenants/{tenantId} {
      // السماح بالإنشاء لأي مستخدم موثق (أثناء الـ Onboarding)
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (getProfileData().tenantId == tenantId || isSuperAdmin());
      allow update: if isAuthenticated() && getProfileData().tenantId == tenantId;
    }

    match /slugs/{slug} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && isSuperAdmin();
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /integrations/{id} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}
