
rules_version = '2';
service cloud.firestore {
  match /databases/saas-prod/documents {
    
    // ==========================================
    // 1. Helper Functions
    // ==========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Direct profile lookup - No dependencies
    function getUserProfile(uid) {
      return get(/databases/$(database)/documents/accountProfiles/$(uid)).data;
    }

    function getTenantId() {
      return getUserProfile(request.auth.uid).tenantId;
    }

    function isTenantMember(tid) {
      return isAuthenticated() && getTenantId() == tid;
    }

    // ==========================================
    // 2. Identity & Access (UID-Keyed)
    // ==========================================
    
    match /accountProfiles/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid == uid || 
        getTenantId() == resource.data.tenantId
      );
    }

    // ==========================================
    // 3. Operational Data (Tenant-Scoped)
    // ==========================================
    
    match /{collectionName}/{id} {
      // Rule for all tenant-scoped business data
      allow read: if isAuthenticated() && (
        isTenantMember(resource.data.tenantId) || 
        // Support Public Storefront Read
        (collectionName in ['products', 'categories', 'banners', 'offers'] && resource.data.tenantId != null)
      );
      
      allow create: if isAuthenticated() && 
                    request.resource.data.tenantId == getTenantId();
                    
      allow update, delete: if isAuthenticated() && 
                           resource.data.tenantId == getTenantId() &&
                           request.resource.data.tenantId == getTenantId();
    }

    // ==========================================
    // 4. Global Registry
    // ==========================================
    
    match /tenants/{tenantId} {
      allow read: if isAuthenticated() && (getTenantId() == tenantId);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && getTenantId() == tenantId;
    }

    match /slugs/{slug} {
      allow read: if true;
      allow create: if isAuthenticated();
    }

    match /plans/{planId} {
      allow read: if true;
    }
  }
}
