
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // وظائف مساعدة مركزية
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // الحصول على tenantId للمستخدم الحالي من بروفايله
    function getTenantId() {
      return get(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data.tenantId;
    }

    // القواعد الأساسية للهوية الرقمية
    match /accountProfiles/{uid} {
      allow read, write: if isOwner(uid);
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid) || (isAuthenticated() && getTenantId() == resource.data.tenantId);
    }

    // سجل الروابط (Slug Registry)
    match /slugs/{slug} {
      allow read: if true;
      // السماح بإنشاء رابط إذا كان غير موجود
      allow create: if isAuthenticated();
      // السماح بحذف الرابط القديم فقط لصاحب المتجر المرتبط به
      allow delete: if isAuthenticated() && resource.data.tenantId == getTenantId();
    }

    // بيانات المتجر الأساسية
    match /tenants/{tenantId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && getTenantId() == tenantId;
    }

    // المنتجات والأقسام والبنرات (قراءة عامة للجمهور، كتابة للتاجر فقط)
    match /{collectionName}/{docId} {
      allow read: if collectionName in ['products', 'categories', 'banners', 'offers', 'motorcycleTypes'];
      
      allow write: if isAuthenticated() && (
        (request.resource != null && request.resource.data.tenantId == getTenantId()) ||
        (resource != null && resource.data.tenantId == getTenantId())
      );
    }

    // البيانات التشغيلية الحساسة (عزل تام حسب الـ Tenant)
    match /{collectionName}/{docId} {
      allow read, write: if collectionName in [
        'orders', 'suppliers', 'purchases', 'expenses', 
        'repairOrders', 'financialTransactions', 'receiptVouchers', 
        'paymentVouchers', 'cashShifts', 'auditLogs', 'apiKeys', 
        'webhooks', 'tenantIntegrations', 'returns', 'subscriptionInvoices',
        'notifications'
      ] && isAuthenticated() && (
        (resource != null && resource.data.tenantId == getTenantId()) || 
        (request.resource != null && request.resource.data.tenantId == getTenantId())
      );
    }

    // المجموعات العالمية للمنصة
    match /plans/{planId} {
      allow read: if true;
    }

    match /integrations/{id} {
      allow read: if true;
    }

    match /settings/{id} {
      allow read: if true;
    }

    // سجلات النظام (لأغراض الموثوقية)
    match /systemLogs/{id} {
      allow create: if true; // السماح للنظام بتسجيل الأخطاء حتى بدون توثيق أحياً
    }
  }
}
