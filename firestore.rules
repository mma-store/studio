rules_version = '2';
service cloud.firestore {
  match /databases/saas-prod/documents {
    
    // ==========================================
    // 1. الوظائف المساعدة (Helpers)
    // ==========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // جلب ملف الهوية - نستخدم UID الوثيقة مباشرة كمرجع
    function getProfile() {
      return get(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data;
    }

    // الحصول على معرف المتجر الخاص بالمستخدم
    function getUserTenantId() {
      return getProfile().tenantId;
    }

    // التحقق من الانتماء للمتجر
    function isTenantMember(tid) {
      return isAuthenticated() && getUserTenantId() == tid;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (getProfile().accountType == 'super_admin' || getProfile().role == 'super_admin');
    }

    // ==========================================
    // 2. الهوية الرقمية (Root of Trust)
    // ==========================================
    
    match /accountProfiles/{uid} {
      // السماح للمستخدم بقراءة ملفه الخاص فقط بناءً على UID الموثق
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
      // السماح لمدير المنصة بالقراءة
      allow read: if isSuperAdmin();
    }

    match /users/{uid} {
      // صلاحية المستخدم لنفسه
      allow read: if isAuthenticated() && request.auth.uid == uid;
      // صلاحية أعضاء المتجر لقراءة زملائهم أو عملائهم
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      // صلاحية الكتابة للمسؤولين
      allow write: if isAuthenticated() && isTenantMember(getUserTenantId());
    }

    // ==========================================
    // 3. البيانات التشغيلية المعزولة (Tenant-Scoped)
    // ==========================================
    
    match /{collectionName}/{id} {
      // نطبق العزل على كافة المجموعات التي تحتوي على tenantId
      allow read: if isAuthenticated() && (
        isTenantMember(resource.data.tenantId) ||
        // دعم المتجر الإلكتروني (قراءة عامة لبعض البيانات)
        (collectionName in ['products', 'categories', 'banners', 'offers'] && resource.data.tenantId != null)
      );

      allow write: if isAuthenticated() && 
                    isTenantMember(getUserTenantId()) &&
                    (request.resource.data.tenantId == getUserTenantId());
                    
      // استثناء للمجموعات الخاصة بمدير المنصة
      allow read, write: if isSuperAdmin();
    }

    // ==========================================
    // 4. السجلات العامة للمنصة (Global)
    // ==========================================
    
    match /tenants/{tenantId} {
      allow read: if isAuthenticated() && (getUserTenantId() == tenantId || isSuperAdmin());
      allow create: if isAuthenticated(); // السماح بإنشاء متجر عند الـ Onboarding
      allow update: if isAuthenticated() && getUserTenantId() == tenantId;
    }

    match /slugs/{slug} {
      allow read: if true; // القراءة العامة مطلوبة للـ Storefront
      allow create, update: if isAuthenticated();
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /integrations/{id} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}