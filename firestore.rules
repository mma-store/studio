rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function getProfile() {
      return get(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        getProfile().accountType == 'super_admin' || getProfile().role == 'super_admin'
      );
    }

    function isTenantMember(tenantId) {
      return isAuthenticated() && (getProfile().tenantId == tenantId || isSuperAdmin());
    }

    function isTenantAdmin(tenantId) {
      return isAuthenticated() && (
        (getProfile().tenantId == tenantId && getProfile().role in ['owner', 'admin']) || 
        isSuperAdmin()
      );
    }

    // --- Identity Rules (CRITICAL FIX) ---
    // Allow users to read/write their own profile using UID
    match /accountProfiles/{uid} {
      allow read, write: if isAuthenticated() && (request.auth.uid == uid || isSuperAdmin());
    }

    match /users/{uid} {
      allow read, write: if isAuthenticated() && (request.auth.uid == uid || isSuperAdmin());
    }

    // --- Tenant Rules ---
    match /tenants/{tenantId} {
      // Allow read if user is member of the tenant
      allow read: if isAuthenticated() && (isTenantMember(tenantId));
      // Allow onboarding for new users (no tenant yet)
      allow create: if isAuthenticated();
      allow update: if isTenantAdmin(tenantId);
    }

    match /slugs/{slug} {
      allow read: if true;
      allow create, update: if isAuthenticated();
    }

    // --- Global Platform Data ---
    match /plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // --- Operational Data (Tenant Isolated) ---
    // Products, Categories, Banners, Offers are public-ish but writable only by admins
    match /products/{id} {
      allow read: if isAuthenticated();
      allow write: if isTenantAdmin(request.resource.data.tenantId || resource.data.tenantId);
    }
    match /categories/{id} {
      allow read: if isAuthenticated();
      allow write: if isTenantAdmin(request.resource.data.tenantId || resource.data.tenantId);
    }
    match /banners/{id} {
      allow read: if isAuthenticated();
      allow write: if isTenantAdmin(request.resource.data.tenantId || resource.data.tenantId);
    }
    match /offers/{id} {
      allow read: if isAuthenticated();
      allow write: if isTenantAdmin(request.resource.data.tenantId || resource.data.tenantId);
    }

    // --- Private/Operational Data (Strict Isolation) ---
    match /{path=**} {
      allow read: if isAuthenticated() && (
        (resource.data.tenantId != null && resource.data.tenantId == getProfile().tenantId) || 
        isSuperAdmin()
      );
      allow write: if isAuthenticated() && (
        (request.resource.data.tenantId != null && request.resource.data.tenantId == getProfile().tenantId && getProfile().role in ['owner', 'admin']) ||
        isSuperAdmin()
      );
    }
  }
}