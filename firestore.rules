rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. القواعد المباشرة للهوية (مستقلة تماماً لمنع الحلقة المفرغة)
    match /accountProfiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 2. وظائف مساعدة آمنة (تستدعى فقط بعد نجاح قراءة الهوية)
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && 
        (getUserData().accountType == 'super_admin' || getUserData().role == 'super_admin');
    }

    function isTenantMember(tenantId) {
      return isAuthenticated() && (
        isSuperAdmin() || 
        getUserData().tenantId == tenantId
      );
    }

    // 3. قواعد المتاجر (Tenants)
    match /tenants/{tenantId} {
      allow read: if isAuthenticated() && isTenantMember(tenantId);
      allow create: if isAuthenticated(); 
      allow update: if isAuthenticated() && isTenantMember(tenantId) && getUserData().role in ['owner', 'admin'];
    }

    // 4. قواعد البيانات التشغيلية (معزولة بالـ tenantId)
    // تشمل: المنتجات، الأقسام، الطلبات، الموردين، المصاريف، إلخ.
    
    match /products/{id} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow write: if isAuthenticated() && isTenantMember(request.resource.data.tenantId) && getUserData().role in ['owner', 'admin', 'warehouse_employee'];
    }

    match /categories/{id} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow write: if isAuthenticated() && isTenantMember(request.resource.data.tenantId) && getUserData().role in ['owner', 'admin'];
    }

    match /orders/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || resource.data.userId == request.auth.uid || isTenantMember(resource.data.tenantId));
      allow write: if isAuthenticated() && (isTenantMember(request.resource.data.tenantId) || isTenantMember(resource.data.tenantId));
    }

    match /suppliers/{id} {
      allow read, write: if isAuthenticated() && isTenantMember(resource.data.tenantId || request.resource.data.tenantId);
    }

    match /expenses/{id} {
      allow read, write: if isAuthenticated() && isTenantMember(resource.data.tenantId || request.resource.data.tenantId);
    }

    match /auditLogs/{id} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow create: if isAuthenticated(); 
    }

    match /subscriptionInvoices/{id} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
    }

    // 5. البيانات العامة للمنصة
    match /plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /slugs/{slug} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}