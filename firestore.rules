rules_version = '2';
service cloud.firestore {
  match /databases/saas-prod/documents {
    
    // ==========================================
    // 1. الوظائف المساعدة (Secure Helpers)
    // ==========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // جلب بيانات البروفايل للتحقق من الصلاحيات والـ Tenant
    function getProfile() {
      return get(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data;
    }

    function isTenantMember(tid) {
      return isAuthenticated() && getProfile().tenantId == tid;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (getProfile().accountType == 'super_admin' || getProfile().role == 'super_admin');
    }

    // ==========================================
    // 2. إدارة الهوية (Identity Layer)
    // ==========================================
    
    // القاعدة الأساسية: لا تستدعي getProfile داخل accountProfiles لتجنب الـ Recursion
    match /accountProfiles/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
      allow read: if isSuperAdmin();
    }

    match /users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isTenantMember(resource.data.tenantId));
      allow write: if isAuthenticated() && isTenantMember(request.resource.data.tenantId);
      allow read, write: if isSuperAdmin();
    }

    // ==========================================
    // 3. البيانات التشغيلية (Tenant-Scoped Data)
    // ==========================================
    
    match /{collectionName}/{id} {
      // السماح بالقراءة العامة لبيانات واجهة المتجر
      allow read: if collectionName in ['products', 'categories', 'banners', 'offers', 'motorcycleTypes'];
      
      // قواعد الكتابة العامة المعزولة بالـ Tenant
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow write: if isAuthenticated() && isTenantMember(request.resource.data.tenantId);
      
      // صلاحيات الـ Super Admin الشاملة
      allow read, write: if isSuperAdmin();
    }

    // استثناء للمجموعات المالية الحساسة (لا قراءة عامة أبداً)
    match /subscriptionInvoices/{id} {
      allow read, write: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow read, write: if isSuperAdmin();
    }

    match /auditLogs/{id} {
      allow read: if isAuthenticated() && isTenantMember(resource.data.tenantId);
      allow create: if isAuthenticated();
      allow read, write: if isSuperAdmin();
    }

    // ==========================================
    // 4. السجلات العامة (Global Infrastructure)
    // ==========================================
    
    match /tenants/{tenantId} {
      allow read: if isAuthenticated() && (getProfile().tenantId == tenantId || isSuperAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && getProfile().tenantId == tenantId;
    }

    match /slugs/{slug} {
      allow read: if true;
      allow create, update: if isAuthenticated();
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /integrations/{id} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}