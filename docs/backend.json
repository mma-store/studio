
{
  "entities": {
    "Tenant": {
      "title": "Tenant",
      "description": "Store or business profile in the SaaS system",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "businessName": { "type": "string" },
        "slug": { "type": "string", "description": "Unique URL slug for the store (e.g. mma-store)" },
        "ownerName": { "type": "string" },
        "logo": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "address": { "type": "string" },
        "businessType": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "trial", "expired", "suspended", "cancelled"] },
        "subscriptionPlanId": { "type": "string" },
        "subscriptionPlan": { "type": "string", "enum": ["trial", "starter", "business", "enterprise"] },
        "trialStartDate": { "type": "number" },
        "trialEndDate": { "type": "number" },
        "currentPeriodStart": { "type": "number" },
        "currentPeriodEnd": { "type": "number" },
        "autoRenew": { "type": "boolean" },
        "suspendedReason": { "type": "string" },
        "createdAt": { "type": "number" },
        "settings": { "type": "object" }
      },
      "required": ["tenantId", "slug", "businessName"]
    },
    "Integration": {
      "title": "Integration",
      "description": "Global third-party service definition",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["payments", "delivery", "finance", "messaging", "maps", "ai", "analytics", "accounting", "marketing"] },
        "logo": { "type": "string" },
        "description": { "type": "string" },
        "provider": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "beta", "coming_soon", "deprecated"] },
        "enabled": { "type": "boolean" },
        "supportedPlans": { "type": "array" },
        "requiredConfiguration": { "type": "array" },
        "createdAt": { "type": "number" }
      }
    },
    "TenantIntegration": {
      "title": "TenantIntegration",
      "description": "Specific tenant configuration for an integration",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "integrationId": { "type": "string" },
        "enabled": { "type": "boolean" },
        "configuration": { "type": "object" },
        "connectedAt": { "type": "number" },
        "lastSync": { "type": "number" },
        "status": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["google", "password"]
  },
  "firestore": {
    "/tenants/{tenantId}": { "schema": "Tenant", "description": "Tenant business configuration" },
    "/integrations/{integrationId}": { "schema": "Integration", "description": "Global integration catalog" },
    "/tenantIntegrations/{id}": { "schema": "TenantIntegration", "description": "Tenant-specific integration settings" },
    "/users/{userId}": { "schema": "UserProfile", "description": "Tenant-scoped user accounts" },
    "/products/{productId}": { "schema": "Product", "description": "Tenant-scoped inventory" },
    "/orders/{orderId}": { "schema": "Order", "description": "Tenant-scoped sales orders" },
    "/auditLogs/{logId}": { "schema": "object", "description": "Administrative actions" }
  }
}
