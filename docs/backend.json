{
  "entities": {
    "Tenant": {
      "title": "Tenant",
      "description": "Store or business profile in the SaaS system",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "businessName": { "type": "string" },
        "slug": { "type": "string" },
        "ownerName": { "type": "string" },
        "ownerUid": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "trial", "suspended", "expired"] },
        "createdAt": { "type": "number" }
      },
      "required": ["tenantId", "slug", "ownerUid"]
    },
    "AccountProfile": {
      "title": "AccountProfile",
      "description": "Canonical identity record for any user in the platform, keyed by UID",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "accountType": { "type": "string", "enum": ["merchant", "super_admin", "customer"] },
        "role": { "type": "string", "enum": ["owner", "admin", "employee", "customer"] },
        "tenantId": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "accountType", "role"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/accountProfiles/{uid}": { "schema": "AccountProfile", "description": "Primary identity (UID-Keyed)" },
    "/users/{uid}": { "schema": "AccountProfile", "description": "User identity records" },
    "/tenants/{tenantId}": { "schema": "Tenant", "description": "Tenant configuration" },
    "/products/{id}": { "schema": "object", "description": "Tenant products" },
    "/categories/{id}": { "schema": "object", "description": "Tenant categories" },
    "/orders/{id}": { "schema": "object", "description": "Tenant orders" },
    "/plans/{id}": { "schema": "object", "description": "Global plans" },
    "/auditLogs/{id}": { "schema": "object", "description": "System audit logs" },
    "/subscriptionInvoices/{id}": { "schema": "object", "description": "Billing records" },
    "/suppliers/{id}": { "schema": "object", "description": "Store suppliers" },
    "/expenses/{id}": { "schema": "object", "description": "Store expenses" },
    "/repairOrders/{id}": { "schema": "object", "description": "Workshop tasks" },
    "/financialTransactions/{id}": { "schema": "object", "description": "Ledger" },
    "/apiKeys/{id}": { "schema": "object", "description": "API access" },
    "/webhooks/{id}": { "schema": "object", "description": "Integrations" }
  }
}