
{
  "entities": {
    "Tenant": {
      "title": "Tenant",
      "description": "Store or business profile in the SaaS system",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "businessName": { "type": "string" },
        "slug": { "type": "string" },
        "ownerName": { "type": "string" },
        "ownerUid": { "type": "string" },
        "logo": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "trial", "suspended", "expired"] },
        "subscriptionPlan": { "type": "string" },
        "createdAt": { "type": "number" },
        "settings": { "type": "object" }
      },
      "required": ["tenantId", "slug", "ownerUid"]
    },
    "AccountProfile": {
      "title": "AccountProfile",
      "description": "Canonical identity record for any user in the platform",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "accountType": { "type": "string", "enum": ["merchant", "super_admin", "customer"] },
        "role": { "type": "string", "enum": ["owner", "admin", "employee", "customer"] },
        "tenantId": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "accountType", "role"]
    },
    "Product": {
      "title": "Product",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "barcode": { "type": "string" },
        "retailPrice": { "type": "number" },
        "stock": { "type": "number" },
        "category": { "type": "string" }
      }
    },
    "Order": {
      "title": "Order",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "orderNumber": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" }
      }
    },
    "Plan": {
      "title": "Plan",
      "description": "Global subscription plans",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "monthlyPrice": { "type": "number" },
        "maxProducts": { "type": "number" },
        "active": { "type": "boolean" }
      }
    }
  },
  "auth": {
    "providers": ["password", "phone"]
  },
  "firestore": {
    "/tenants/{tenantId}": { "schema": "Tenant", "description": "Tenant configuration" },
    "/accountProfiles/{uid}": { "schema": "AccountProfile", "description": "Primary user identity" },
    "/users/{uid}": { "schema": "AccountProfile", "description": "Legacy compatible user record" },
    "/plans/{planId}": { "schema": "Plan", "description": "Global plans" },
    "/products/{productId}": { "schema": "Product", "description": "Multi-tenant products" },
    "/orders/{orderId}": { "schema": "Order", "description": "Multi-tenant orders" },
    "/repairOrders/{id}": { "schema": "object", "description": "Workshop tasks" },
    "/suppliers/{id}": { "schema": "object", "description": "Store suppliers" },
    "/purchases/{id}": { "schema": "object", "description": "Inventory purchases" },
    "/financialTransactions/{id}": { "schema": "object", "description": "Finance log" },
    "/cashShifts/{id}": { "schema": "object", "description": "Daily shifts" },
    "/expenses/{id}": { "schema": "object", "description": "Store expenses" },
    "/auditLogs/{id}": { "schema": "object", "description": "System changes" },
    "/categories/{id}": { "schema": "object", "description": "Tenant categories" },
    "/banners/{id}": { "schema": "object", "description": "Tenant banners" },
    "/offers/{id}": { "schema": "object", "description": "Tenant offers" },
    "/slugs/{slug}": { "schema": "object", "description": "Registry for unique URLs" }
  }
}
