
{
  "entities": {
    "Tenant": {
      "title": "Tenant",
      "description": "Store or business profile in the SaaS system",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "businessName": { "type": "string" },
        "slug": { "type": "string" },
        "ownerName": { "type": "string" },
        "ownerUid": { "type": "string" },
        "logo": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "trial", "suspended", "expired"] },
        "subscriptionPlan": { "type": "string" },
        "subscriptionPlanId": { "type": "string" },
        "createdAt": { "type": "number" },
        "trialEndDate": { "type": "number" },
        "currentPeriodEnd": { "type": "number" },
        "settings": { "type": "object" }
      },
      "required": ["tenantId", "slug", "ownerUid"]
    },
    "AccountProfile": {
      "title": "AccountProfile",
      "description": "Canonical identity record for any user in the platform, keyed by UID",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "accountType": { "type": "string", "enum": ["merchant", "super_admin", "customer"] },
        "role": { "type": "string", "enum": ["owner", "admin", "employee", "customer"] },
        "tenantId": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "accountType", "role"]
    }
  },
  "auth": {
    "providers": ["password", "phone"]
  },
  "firestore": {
    "/accountProfiles/{uid}": { "schema": "AccountProfile", "description": "Primary identity (UID-Keyed)" },
    "/users/{uid}": { "schema": "AccountProfile", "description": "Legacy compatible identity (UID-Keyed)" },
    "/tenants/{tenantId}": { "schema": "Tenant", "description": "Tenant configuration" },
    "/plans/{planId}": { "schema": "object", "description": "Global subscription plans" },
    "/slugs/{slug}": { "schema": "object", "description": "Slug unique registry" },
    "/products/{id}": { "schema": "object", "description": "Multi-tenant products" },
    "/orders/{id}": { "schema": "object", "description": "Multi-tenant orders" },
    "/repairOrders/{id}": { "schema": "object", "description": "Workshop tasks" },
    "/suppliers/{id}": { "schema": "object", "description": "Suppliers" },
    "/purchases/{id}": { "schema": "object", "description": "Inventory purchases" },
    "/expenses/{id}": { "schema": "object", "description": "Expenses" },
    "/auditLogs/{id}": { "schema": "object", "description": "Audit trails" },
    "/categories/{id}": { "schema": "object", "description": "Categories" },
    "/banners/{id}": { "schema": "object", "description": "Banners" },
    "/offers/{id}": { "schema": "object", "description": "Offers" },
    "/financialTransactions/{id}": { "schema": "object", "description": "Finance" },
    "/cashShifts/{id}": { "schema": "object", "description": "Shifts" },
    "/subscriptionInvoices/{id}": { "schema": "object", "description": "Billing records" },
    "/paymentVouchers/{id}": { "schema": "object", "description": "Outgoing payments" },
    "/receiptVouchers/{id}": { "schema": "object", "description": "Incoming payments" },
    "/apiKeys/{id}": { "schema": "object", "description": "Developer keys" },
    "/webhooks/{id}": { "schema": "object", "description": "Developer webhooks" },
    "/systemLogs/{id}": { "schema": "object", "description": "Critical system alerts" },
    "/notifications/{id}": { "schema": "object", "description": "User notifications" }
  }
}
