
{
  "entities": {
    "Tenant": {
      "title": "Tenant",
      "description": "Store or business profile in the SaaS system",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "businessName": { "type": "string" },
        "slug": { "type": "string", "description": "Unique URL slug for the store (e.g. mma-store)" },
        "ownerName": { "type": "string" },
        "logo": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "address": { "type": "string" },
        "businessType": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "trial", "expired", "suspended", "cancelled"] },
        "subscriptionPlanId": { "type": "string" },
        "subscriptionPlan": { "type": "string", "enum": ["trial", "starter", "business", "enterprise"] },
        "trialStartDate": { "type": "number" },
        "trialEndDate": { "type": "number" },
        "currentPeriodStart": { "type": "number" },
        "currentPeriodEnd": { "type": "number" },
        "autoRenew": { "type": "boolean" },
        "suspendedReason": { "type": "string" },
        "createdAt": { "type": "number" },
        "settings": { "type": "object" }
      },
      "required": ["tenantId", "slug", "businessName"]
    },
    "SubscriptionPlan": {
      "title": "SubscriptionPlan",
      "description": "Global definitions of service tiers",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "priceIQD": { "type": "number" },
        "billingCycle": { "type": "string", "enum": ["monthly", "yearly"] },
        "maxProducts": { "type": "number" },
        "maxEmployees": { "type": "number" },
        "maxOrdersPerMonth": { "type": "number" },
        "storageLimitMB": { "type": "number" },
        "aiQuota": { "type": "number" },
        "posEnabled": { "type": "boolean" },
        "reportsEnabled": { "type": "boolean" },
        "workshopEnabled": { "type": "boolean" },
        "onlineStoreEnabled": { "type": "boolean" },
        "customDomainEnabled": { "type": "boolean" },
        "prioritySupport": { "type": "boolean" },
        "isActive": { "type": "boolean" }
      }
    },
    "SubscriptionInvoice": {
      "title": "SubscriptionInvoice",
      "description": "B2B Billing records for tenants",
      "type": "object",
      "properties": {
        "invoiceNumber": { "type": "string" },
        "tenantId": { "type": "string" },
        "planName": { "type": "string" },
        "amountIQD": { "type": "number" },
        "status": { "type": "string", "enum": ["paid", "pending", "overdue"] },
        "issueDate": { "type": "number" },
        "dueDate": { "type": "number" },
        "paymentDate": { "type": "number" },
        "notes": { "type": "string" }
      }
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account information linked to a tenant",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "tenantId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "owner", "admin", "sales_employee", "workshop_technician", "warehouse_employee", "retail_customer", "wholesale_customer"] },
        "currentBalance": { "type": "number" }
      },
      "required": ["uid", "tenantId", "role"]
    }
  },
  "auth": {
    "providers": ["google", "password"]
  },
  "firestore": {
    "/tenants/{tenantId}": { "schema": "Tenant", "description": "Tenant business configuration" },
    "/plans/{planId}": { "schema": "SubscriptionPlan", "description": "Global subscription plan definitions" },
    "/subscriptionInvoices/{invoiceId}": { "schema": "SubscriptionInvoice", "description": "Tenant billing records" },
    "/users/{userId}": { "schema": "UserProfile", "description": "Tenant-scoped user accounts" },
    "/products/{productId}": { "schema": "Product", "description": "Tenant-scoped inventory" },
    "/orders/{orderId}": { "schema": "Order", "description": "Tenant-scoped sales orders" },
    "/auditLogs/{logId}": { "schema": "object", "description": "Administrative actions" }
  }
}
