{
  "entities": {
    "Tenant": {
      "title": "Tenant",
      "description": "Store or business profile in the SaaS system",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "businessName": { "type": "string" },
        "slug": { "type": "string", "description": "Unique URL slug for the store (e.g. mma-store)" },
        "ownerName": { "type": "string" },
        "logo": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "address": { "type": "string" },
        "businessType": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "trial", "expired", "suspended", "cancelled"] },
        "subscriptionPlanId": { "type": "string" },
        "subscriptionPlan": { "type": "string", "enum": ["trial", "starter", "business", "enterprise"] },
        "trialStartDate": { "type": "number" },
        "trialEndDate": { "type": "number" },
        "currentPeriodStart": { "type": "number" },
        "currentPeriodEnd": { "type": "number" },
        "autoRenew": { "type": "boolean" },
        "suspendedReason": { "type": "string" },
        "createdAt": { "type": "number" },
        "settings": { "type": "object" }
      },
      "required": ["tenantId", "slug", "businessName"]
    },
    "SlugRegistry": {
      "title": "SlugRegistry",
      "description": "Global registry to enforce unique store slugs and allow public resolution",
      "type": "object",
      "properties": {
        "tenantId": { "type": "string" },
        "businessName": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["tenantId"]
    },
    "ApiKey": {
      "title": "ApiKey",
      "description": "Developer API access keys",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "key": { "type": "string" },
        "permissions": { "type": "array" },
        "status": { "type": "string", "enum": ["active", "revoked", "expired"] },
        "createdAt": { "type": "number" },
        "expiresAt": { "type": "number" },
        "lastUsed": { "type": "number" }
      }
    },
    "Webhook": {
      "title": "Webhook",
      "description": "Outbound event notifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "url": { "type": "string" },
        "secret": { "type": "string" },
        "events": { "type": "array" },
        "enabled": { "type": "boolean" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" },
        "lastDelivery": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["google", "password"]
  },
  "firestore": {
    "/tenants/{tenantId}": { "schema": "Tenant", "description": "Tenant business configuration" },
    "/slugs/{slug}": { "schema": "SlugRegistry", "description": "Registry to ensure unique store slugs across the platform" },
    "/apiKeys/{id}": { "schema": "ApiKey", "description": "Tenant API credentials" },
    "/webhooks/{id}": { "schema": "Webhook", "description": "Tenant outbound webhooks" },
    "/apiLogs/{id}": { "schema": "object", "description": "API request logs" }
  }
}