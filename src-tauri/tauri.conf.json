
{
  "productName": "DUBSAR 2.0",
  "version": "2.0.0",
  "identifier": "com.dubsar.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:9002",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "DUBSAR 2.0 - Management System",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": {
        "dubsar": "sqlite:dubsar.db"
      }
    }
  }
}
